{
  "name": "@recidivist/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "upload": "tsx --env-file-if-exists=../../.env src/scripts/upload.ts",
    "typecheck": "tsc --noEmit",
    "check-data": "tsx --env-file-if-exists=../../.env src/scripts/check-data.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@recidivist/core": "workspace:*",
    "@recidivist/db": "workspace:*",
    "@recidivist/memory": "workspace:*",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
