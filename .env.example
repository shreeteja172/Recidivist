# Copy to .env and fill in. Used by docker compose, the API server and scripts.

# --- App database (docker compose "postgres" service) ---
DATABASE_URL=postgres://recidivist:recidivist@localhost:5433/recidivist

# --- Hindsight memory ---
# Local Docker: http://localhost:8888 (web UI at http://localhost:9999)
# Hindsight Cloud: https://api.hindsight.vectorize.io and set HINDSIGHT_API_KEY
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# LLM that the local Hindsight container uses for extraction and reflect.
# Providers: openai, anthropic, groq, gemini, ... (anthropic/groq/gemini need HINDSIGHT_LLM_MODEL set)
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_MODEL=gpt-5-mini
HINDSIGHT_LLM_API_KEY=

# --- API server ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4000
